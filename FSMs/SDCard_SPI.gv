digraph SDCard_SPI_FSM {
    rankdir=LR; // Left-to-right layout
    
    node [shape=Rectangle]; // Nodes will be circular
    
    label="SD Card Finite State Machine (Asynchronous Side by Side Composition)"

    Node1 [label="Sensor Application"];
    Node2 [label="Host Driver"];
    Node3 [label="Card Driver"];
    Node4 [label="Card Intenals"];

    //Sensor to Host
    Node1 -> Node2 [label="VOLTAGE", constraint = true , weight = 1,];
    Node1 -> Node2 [label="DATA_READ.COUNT", constraint = true , weight = 1,];
    Node1 -> Node2 [label="DATA_READ.ADDRESS", constraint = true , weight = 1,];
    Node1 -> Node2 [label="DATA_WRITE.COUNT", constraint = true , weight = 1,];
    Node1 -> Node2 [label="DATA_WRITE.ADDRESS", constraint = true , weight = 1,];
    Node1 -> Node2 [label="DATA_WRITE.DATA", constraint = true , weight = 1,];
    Node1 -> Node2 [label="POWER_ON", constraint = true , weight = 1,];
    Node1 -> Node2 [label="POWER_OFF", constraint = true , weight = 1,];

    // Host to Sensor
    Node2 -> Node1 [label="DATA_READ.DATA", constraint = true , weight = 1,];

    //Host to Card
    Node2 -> Node3 [label="MOSI.CMD", constraint = true , weight = 1,];
    Node2 -> Node3 [label="MOSI.ARG", constraint = true , weight = 1,];
    Node2 -> Node3 [label="MOSI.DATA", constraint = true , weight = 1,];
    Node2 -> Node3 [label="CLK", constraint = true , weight = 1,];
    Node2 -> Node3 [label="CS", constraint = true , weight = 1,];
    Node2 -> Node3 [label="POWER_ON", constraint = true , weight = 1,];
    Node2 -> Node3 [label="POWER_OFF", constraint = true , weight = 1,];    
    
    //Card to Host
    Node2 -> Node3 [label="MISO.RESP", constraint = true , weight = 1,];
    Node2 -> Node3 [label="MISO.ARG", constraint = true , weight = 1,];
    Node2 -> Node3 [label="MISO.DATA", constraint = true , weight = 1,];

    // Card to Card Internals
    Node3 -> Node4 [label="WRITE_BLOCK_512(Address)", constraint = true , weight = 1,];
 
    //Card Internals to Card
    Node4 -> Node3 [label="READ_BLOCK_512(Address)", constraint = true , weight = 1,];
    Node4 -> Node3 [label="CARD_BUSY", constraint = true , weight = 1,];
    Node4 -> Node3 [label="MAX_ADDRESS", constraint = true , weight = 1,];
    Node4 -> Node3 [label="CARD_VERSION", constraint = true , weight = 1,];
    Node4 -> Node3 [label="CARD_VOLTAGE", constraint = true , weight = 1,];
}
