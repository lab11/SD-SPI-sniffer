digraph Card_CIM {
  rankdir=LR; // Left-to-right layout
  node [shape=circle]; // Nodes will be circular

  Node1 [label="Idle", fontsize="80", penwidth="10"];
  Node2 [label="Read Ready", fontsize="80", penwidth="10"];
  Node3 [label="Read Busy", fontsize="80", penwidth="10"];
  Node4 [label="Write-Ready", fontsize="80", penwidth="10"];
  Node5 [label="Write-Busy", fontsize="80", penwidth="10"];

  label="Card Data Transfer Mode"

    //Read transitions
    Node1 -> Node3 [label="D1", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node1 -> Node3 [label="D2", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node3 -> Node2 [label="D3", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node2 -> Node3 [label="D4", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node2 -> Node1 [label="D5", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node3 -> Node3 [label="D6", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node3 -> Node1 [label="D7", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node2 -> Node1 [label="D8", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    
    
    //Write transitions
    Node1 -> Node4 [label="D9", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node1 -> Node5 [label="D10", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node4 -> Node5 [label="D11", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5:s -> Node5:s [label="D12", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node4 -> Node4 [label="D13", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5 -> Node5 [label="D14", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node4 -> Node4 [label="D15", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5 -> Node5 [label="D16", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5:s -> Node5:s [label="D17", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node4 -> Node1 [label="D18", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5 -> Node4:s [label="D19", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
    Node5 -> Node1:s [label="D20", constraint = true , weight = 1, fontsize="40", penwidth="7", style=bold];
 
 
  legend [shape=plaintext,  fontsize="60", penwidth="10", label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR>
        <TD><B>States</B></TD>
        <TD>Idle, Ready busy, Read Ready <BR/>
        Write Ready, Write Busy</TD>
      </TR>
      <TR>
        <TD><B>Inputs</B></TD>
        <TD>
          MOSI.CMD ∈ {0, 1, ... ,59}<BR/>
          MOSI.ARG ∈ {Data}<BR/>
          MOSI.DATA ∈ {Data}<BR/>
          READ_BLOCK_512(Address) ∈ {Data}<BR/>
          CARD_BUSY ∈{True, False}<BR/>
          MAX_ADDRESS ∈{0x00000000, ...., 0xFFFFFFFF}}<BR/>
        </TD>
      </TR>
      <TR>
        <TD><B>Outputs</B></TD>
        <TD>
          MISO.RESP ∈ {1,2,3...,7}<BR/>
          MISO.ARG ∈ {Data}<BR/>
          MISO.DATA ∈ {Data} <BR/>
          WRITE_BLOCK_512(Address) ∈ {Data}
        </TD>
      </TR>
      <TR>
        <TD><B>State Variables</B></TD>
        <TD>
            read_cnt c I <BR/>
            write_cnt ∈ I <BR/>
            write_done ∈ {True, False} <BR/> 
            write_adddress ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
            write_more  ∈ {stop ,single ,multi}
        </TD>
      </TR>
      <TR>
        <TD><B>Initialization</B></TD>
        <TD>
            read_cnt := 0<BR/>
            write_cnt := 0<BR/>
            write_done:= False <BR/> 
            write_adddress := 0x00000000<BR/>
            write_more := stop
        </TD>
      </TR>
    </TABLE>
  >];
}