digraph Host_SS {
    rankdir=LR; // Left-to-right layout
    
    node [shape=circle]; // Nodes will be circular
    
    label="Host Data Transfer State Machine"

    Node1 [label="Idle"];
    Node3 [label="Reading"];
    Node4 [label="Writing"];


    //transitions

    Node1 -> Node3 [label="HD1", constraint = true , weight = 1];
    Node1 -> Node3 [label="HD2", constraint = true , weight = 1];
    Node3 -> Node3 [label="HD3", constraint = true , weight = 1];
    Node3 -> Node1 [label="HD4", constraint = true , weight = 1];
    Node3 -> Node3 [label="HD5", constraint = true , weight = 1];
    Node3 -> Node1 [label="HD6", constraint = true , weight = 1];
    Node3 -> Node1 [label="HD7", constraint = true , weight = 1];
    Node1:se -> Node4 [label="HD8", constraint = true , weight = 1];
    Node1:se -> Node4 [label="HD9", constraint = true , weight = 1];
    Node4 -> Node4 [label="HD10", constraint = true , weight = 1];
    Node4 -> Node4 [label="HD11", constraint = true , weight = 1];
    Node4 -> Node1:s [label="HD12", constraint = true , weight = 1];
    Node4 -> Node1:s [label="HD13", constraint = true , weight = 1];
    Node4 -> Node1:s [label="HD13", constraint = true , weight = 1];


  legend [shape=plaintext, label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR>
        <TD><B>States</B></TD>
        <TD>Idle, Read Ready, Read Busy, Writing</TD>
      </TR>
      <TR>
        <TD><B>Inputs</B></TD>
        <TD>
          MISO_RESP ∈ {1,2,3...,7}<BR/>
          MISO_ARG ∈ {Data}<BR/>
          MISO.DATA ∈ {Data}<BR/>
          DATA_READ.ADDRESS ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
          DATA_READ.COUNT ∈ I<BR/>
          DATA_WRITE.ADDRESS ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
          DATA_WRITE.COUNT ∈ I<BR/>
          DATA_WRITE.DATA ∈ {Data}<BR/>
        </TD>
      </TR>
      <TR>
        <TD><B>Outputs</B></TD>
        <TD>
          MOSI.CMD ∈ {0, 1, ... ,59}<BR/>
          MOSI.ARG ∈ {Data}<BR/>
          CS ∈ {True, False}<BR/>
          ERR_VOLTAGE ∈ {Pure}<BR/>
          ERR_NOT_SPI ∈ {Pure}<BR/>
          ERR_ILLEGAL_ADDRESS ∈ {Pure}<BR/>
          DATA_READ.DATA ∈ {Data}
        </TD>
      </TR>
      <TR>
        <TD><B>State Variables</B></TD>
        <TD>
            timer_cnt ∈ (0 ,1, 2, 3, 4, 5) <BR/>
            read_cnt ∈ {0,...2^32}<BR/>
            read_more ∈ {True, False}<BR/>
            write_more ∈ {True, False}<BR/>
            write_cnt ∈ {0,...2^32}
        </TD>
      </TR>
    </TABLE>
  >];
}
