digraph Host_SS {
    rankdir=LR; // Left-to-right layout
    
    node [shape=circle]; // Nodes will be circular
    
    label="Host Data Transfer State Machine"

    Node1 [label="Single operation"];
    Node2 [label="Multi Read"];
    Node3 [label="Multi Write"];

  legend [shape=plaintext, label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR>
        <TD><B>States</B></TD>
        <TD>Single Operation, Multi Read, Multi Write</TD>
      </TR>
      <TR>
        <TD><B>Inputs</B></TD>
        <TD>
          MISO_RESP ∈ {1,2,3...,7}<BR/>
          MISO_ARG ∈ {Data}<BR/>
          MISO.DATA ∈ {Data}<BR/>
          DATA_READ.ADDRESS ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
          DATA_READ.COUNT ∈ I<BR/>
          DATA_WRITE.ADDRESS ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
          DATA_WRITE.COUNT ∈ I<BR/>
          DATA_WRITE.DATA ∈ {Data}<BR/>
        </TD>
      </TR>
      <TR>
        <TD><B>Outputs</B></TD>
        <TD>
          MOSI.CMD ∈ {0, 1, ... ,59}<BR/>
          MOSI.ARG ∈ {Data}<BR/>
          CS ∈ {True, False}<BR/>
          DATA_READ.DATA ∈ {Data}
        </TD>
      </TR>
      <TR>
        <TD><B>State Variables</B></TD>
        <TD>
            timer_cnt ∈ (0 ,1, 2, 3, 4, 5) <BR/>
            read_cnt ∈ {0,...2^32}<BR/>
            write_cnt ∈ {0,...2^32}
        </TD>
      </TR>
    </TABLE>
  >];

    //transitions

    Node1 -> Node2 [label="HD1", constraint = true , weight = 1,];
    Node1 -> Node1 [label="HD2", constraint = true , weight = 1,];
    Node1 -> Node1 [label="HD3", constraint = true , weight = 1,];
    Node2 -> Node1 [label="HD4", constraint = true , weight = 1,];
    Node2 -> Node2 [label="HD5", constraint = true , weight = 1,];
    Node2 -> Node1 [label="HD6", constraint = true , weight = 1,];
    Node1 -> Node3 [label="HD7", constraint = true , weight = 1,];
    Node1 -> Node1 [label="HD8", constraint = true , weight = 1,];
    Node3 -> Node3 [label="HD9", constraint = true , weight = 1,];
    Node3 -> Node3 [label="HD10", constraint = true , weight = 1,];
    Node3 -> Node1 [label="HD11", constraint = true , weight = 1,];
    Node3 -> Node1 [label="HD12", constraint = true , weight = 1,];
    Node1 -> Node1 [label="HD13", constraint = true , weight = 1,];

}
