digraph Card_CIM {
  rankdir=LR; // Left-to-right layout
  node [shape=circle]; // Nodes will be circular

  Node1 [label="Idle"];
  Node2 [label="Multi-Read"];
  Node3 [label="Write-Ready"];
  Node4 [label="Write-Busy"];

  label="Card Data Transfer Mode"
  legend [shape=plaintext, label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR>
        <TD><B>States</B></TD>
        <TD>Idle, Ready</TD>
      </TR>
      <TR>
        <TD><B>Inputs</B></TD>
        <TD>
          MOSI.CMD ∈ {0, 1, ... ,59}<BR/>
          MOSI.ARG ∈ {Data}<BR/>
          MOSI.DATA ∈ {Data}<BR/>
          READ_BLOCK_512(Address) ∈ {Data}<BR/>
          CARD_BUSY ∈{True, False}<BR/>
          MAX_ADDRESS ∈{0x00000000, ...., 0xFFFFFFFF}}<BR/>
        </TD>
      </TR>
      <TR>
        <TD><B>Outputs</B></TD>
        <TD>
          MISO.RESP ∈ {1,2,3...,7}<BR/>
          MISO.ARG ∈ {Data}<BR/>
          MISO.DATA ∈ {Data} <BR/>
          WRITE_BLOCK_512(Address) ∈ {Data}
        </TD>
      </TR>
      <TR>
        <TD><B>State Variables</B></TD>
        <TD>
            read_cnt c I <BR/>
            write_cnt ∈ I <BR/>
            write_done ∈ {True, False} <BR/> 
            write_adddress ∈ {0x00000000, ..., 0xFFFFFFFF}<BR/>
            write_more  ∈ {True, False}
        </TD>
      </TR>
    </TABLE>
  >];

    //transitions
    Node1:w -> Node1:w [label="D1", constraint = true , weight = 1];
    Node1 -> Node2 [label="D2", constraint = true , weight = 1];
    Node2 -> Node2 [label="D3", constraint = true , weight = 1];
    Node2 -> Node1 [label="D4", constraint = true , weight = 1];
    Node2 -> Node1 [label="D5", constraint = true , weight = 1];
    Node1 -> Node3 [label="D6", constraint = true , weight = 1];
    Node1 -> Node3 [label="D7", constraint = true , weight = 1];
    Node3 -> Node4 [label="D8", constraint = true , weight = 1];
    Node3 -> Node1 [label="D9", constraint = true , weight = 1];
    Node4 -> Node4 [label="D10", constraint = true , weight = 1];
    Node3 -> Node3 [label="D11", constraint = true , weight = 1];
    Node4 -> Node4 [label="D12", constraint = true , weight = 1];
    Node4 -> Node4 [label="D13", constraint = true , weight = 1];
    Node3 -> Node1 [label="D14", constraint = true , weight = 1];
    Node4 -> Node3 [label="D15", constraint = true , weight = 1];
    Node4 -> Node1 [label="D16", constraint = true , weight = 1];
}
