digraph Card_CIM {
    rankdir=LR; // Left-to-right layout
    node [shape=rectangle]; // Nodes will be circular

    Node1 [label="Idle"];
    Node2 [label="Ready"];
  label="Card Initialization Mode"
  legend [shape=plaintext, label=<
   <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4">
      <TR>
        <TD><B>States</B></TD>
        <TD>Idle (Initial), Ready</TD>
      </TR>
      <TR>
        <TD><B>Inputs</B></TD>
        <TD>
          MOSI.CMD ∈ {0, 1, ... ,59}<BR/>
          MOSI.ARG ∈ {Data}<BR/>
          MOSI.DATA ∈ {Data}<BR/>
          CARD_BUSY ∈{True, False}<BR/>
          MAX_ADDRESS ∈{0x00000000, ...., 0xFFFFFFFF}}<BR/>
          CARD_VERSION ∈{1.x, 2.x}<BR/>
          CARD_VOLTAGE ∈{0, 1} (0 implies 3.3v and 1 implies 1.2V)
        </TD>
      </TR>
      <TR>
        <TD><B>Outputs</B></TD>
        <TD>
          MISO.RESP ∈ {1,2,3...,7}<BR/>
          MISO.ARG ∈ {Data}<BR/>
          MISO.DATA ∈ {Data}
        </TD>
      </TR>
      <TR>
        <TD><B>State Variables</B></TD>
        <TD>
          cmd8_recv ∈ {pure}<BR/>
          op_voltage ∈ {1.2V, 3.3V}<BR/>
          card_ver ∈ {1.x, 2.x} <BR/>
          card_ready ∈ {pure} 
        </TD>
      </TR>
    </TABLE>
  >];
    Node1 -> Node1 [label="T1", constraint = true , weight = 1];
    Node1 -> Node2 [label="T2", constraint = true , weight = 1];
    Node1 -> Node1 [label="T3", constraint = true , weight = 1];
    Node1 -> Node1 [label="T4", constraint = true , weight = 1];
    Node1 -> Node1 [label="T5", constraint = true , weight = 1];
}
